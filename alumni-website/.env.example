# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/alumni-website
# For MongoDB Atlas, use: mongodb+srv://username:password@cluster.mongodb.net/alumni-website

# JWT Configuration (use a long random string in production)
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE=7d

# Admin bootstrap (used by scripts/create-admin.js)
ADMIN_EMAIL=admin@alumni.com
# Leave ADMIN_PASSWORD unset to have a random password generated and printed once
# ADMIN_PASSWORD=

# Email Configuration (optional - registration works without it, verification emails are skipped)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Frontend URL (used in verification/reset email links)
FRONTEND_URL=http://localhost:3000
